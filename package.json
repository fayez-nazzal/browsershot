{
  "name": "@fayeznazzal/browsershot",
  "version": "1.0.0",
  "description": "CLI for AI coding agents: capture a web page to a PNG via the Playwright Chromium headless shell, with a JSON contract to assert on.",
  "type": "module",
  "keywords": [
    "ai-agents",
    "agent-tools",
    "claude-code",
    "codex",
    "antigravity",
    "grok-cli",
    "cursor",
    "opencode",
    "agentic",
    "cli",
    "screenshot",
    "playwright",
    "headless-browser",
    "pr-evidence"
  ],
  "bin": {
    "browsershot": "dist/browsershot"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build --compile src/cli.ts --external chromium-bidi --outfile dist/browsershot",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  }
}
