{
  "name": "@fayeznazzal/browsershot",
  "version": "1.0.1",
  "description": "Capture a web page to a PNG or GIF via your installed Chrome (Playwright).",
  "type": "module",
  "bin": {
    "browsershot": "dist/browsershot"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build --compile src/cli.ts --external chromium-bidi --outfile dist/browsershot",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  }
}
